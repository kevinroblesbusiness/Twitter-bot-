# Fanvue OAuth
FANVUE_CLIENT_ID=your_client_id_here
FANVUE_CLIENT_SECRET=your_client_secret_here
FANVUE_REDIRECT_URI=http://localhost:3001/api/auth/callback
FANVUE_WEBHOOK_SECRET=your_webhook_secret_here

# Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fanvue_chatbot
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auto-approval threshold (0.0-1.0)
AUTO_APPROVE_THRESHOLD=0.8
