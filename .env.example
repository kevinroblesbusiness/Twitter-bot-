# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Higgsfield AI ───────────────────────────────────────────────────────────
HIGGSFIELD_EMAIL=your_higgsfield_email@example.com
HIGGSFIELD_PASSWORD=your_higgsfield_password

# ── Schedule ────────────────────────────────────────────────────────────────
# Times to run each day (24h format, comma-separated). Default: 3 runs/day.
# Each run generates 2 images per model (6 images/model/day, 18 total).
SCHEDULE_TIMES=08:00,14:00,20:00

# ── Twitter / X ─────────────────────────────────────────────────────────────
# Set TWITTER_ENABLED=true to post generated images automatically.
# Credentials come from developer.twitter.com → your app → Keys and Tokens.
TWITTER_ENABLED=false
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
# Your @handle without the @, used to build tweet URLs in logs (optional)
TWITTER_USERNAME=your_twitter_username
# Caption template – {model} is replaced with the character name (optional)
TWITTER_CAPTION_TEMPLATE=✨ {model} – AI fashion photography #AIArt #Fashion

# ── Misc ────────────────────────────────────────────────────────────────────
# Folder on your computer where images will be saved
DOWNLOAD_DIR=downloads
# Set to "true" to run without opening a browser window
HEADLESS=true
