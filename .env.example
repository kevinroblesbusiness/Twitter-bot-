# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Higgsfield AI ───────────────────────────────────────────────────────────
HIGGSFIELD_EMAIL=your_higgsfield_email@example.com
HIGGSFIELD_PASSWORD=your_higgsfield_password

# ── Google Drive ────────────────────────────────────────────────────────────
# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# ID of the Google Drive folder to upload images into
# (Get this from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ── Schedule ────────────────────────────────────────────────────────────────
# Times to run each day (24h format, comma-separated). Default: 3 runs/day.
# Each run generates 2 images per model (6 images/model/day, 18 total).
SCHEDULE_TIMES=08:00,14:00,20:00

# ── Misc ────────────────────────────────────────────────────────────────────
# Directory to temporarily save downloaded images before uploading
DOWNLOAD_DIR=downloads
# Set to "true" to run headless browser (no visible window)
HEADLESS=true
